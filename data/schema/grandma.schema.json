{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grandma.schema.json",
  "title": "GrandmaWorld",
  "description": "One Grandma's world: the haystack (facts) and the password recipes (needles). The server keeps recipes[].password secret; the client never receives facts or passwords.",
  "type": "object",
  "required": ["id", "version", "profile", "entities", "facts", "recipes"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "seed": { "type": ["integer", "null"], "description": "RNG seed for generated worlds; null for hand-written." },
    "source": { "enum": ["hand-written", "generated"] },
    "profile": {
      "type": "object",
      "required": ["name", "birth_year", "hometown", "personality", "verbal_tics"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "birth_year": { "type": "integer", "minimum": 1925, "maximum": 1960 },
        "hometown": { "type": "string" },
        "personality": {
          "type": "object",
          "required": ["talkativeness", "teasing", "nostalgia", "suspicion_of_kids_these_days"],
          "additionalProperties": false,
          "properties": {
            "talkativeness": { "type": "integer", "minimum": 1, "maximum": 5 },
            "teasing": { "type": "integer", "minimum": 1, "maximum": 5 },
            "nostalgia": { "type": "integer", "minimum": 1, "maximum": 5 },
            "suspicion_of_kids_these_days": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "humor_style": { "type": "string" },
        "verbal_tics": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["person", "pet", "place", "object", "organization", "event"] },
          "name": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "relation_to_player": { "type": "string", "description": "e.g. 'your mom', 'your great-uncle'" }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "subject", "predicate", "object", "text", "salience"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "subject": { "type": "string", "description": "entity id" },
          "predicate": { "type": "string" },
          "object": { "type": ["string", "integer"], "description": "entity id, literal string, or number" },
          "year": { "type": "integer" },
          "text": { "type": "string", "description": "Canonical natural-language statement, in Grandma's first person." },
          "tags": { "type": "array", "items": { "type": "string" } },
          "confusable_with": { "type": "array", "items": { "type": "string" }, "description": "fact ids that a vague question could mix up with this one" },
          "disambiguator": { "type": "string", "description": "The qualifier that resolves the confusion, e.g. 'first', 'when your mom was born'" },
          "salience": { "type": "integer", "minimum": 1, "maximum": 5, "description": "How readily Grandma brings it up unprompted" }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phrase", "resolves_to_year", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "phrase": { "type": "string", "description": "How Grandma refers to the time, e.g. 'the winter Michael broke his arm sledding'" },
          "resolves_to_year": { "type": "integer" },
          "via_fact_ids": { "type": "array", "items": { "type": "string" }, "description": "Facts the player can use to resolve the anchor" },
          "source": { "enum": ["family", "public"] }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "fact_ids", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "fact_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "text": { "type": "string" }
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "difficulty", "note_text", "slots", "format", "password"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "difficulty": { "enum": ["easy", "medium", "hard", "expert"] },
          "note_text": { "type": "string" },
          "smudged_text": { "type": "string" },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["fact_id", "field"],
              "additionalProperties": false,
              "properties": {
                "fact_id": { "type": "string" },
                "field": { "enum": ["object", "year"] },
                "transform": { "enum": ["none", "capitalize", "lowercase", "uppercase", "first_word"], "description": "first_word: keep only the first word of the entity name, e.g. Cherry Street -> Cherry" },
                "requires_anchor": { "type": "string", "description": "anchor id if the value is only given relatively" }
              }
            }
          },
          "literal_suffix": { "type": "string" },
          "format": {
            "type": "object",
            "required": ["join"],
            "additionalProperties": false,
            "properties": {
              "join": { "type": "string" },
              "rules_shown_on_note": { "type": "array", "items": { "type": "string" } }
            }
          },
          "password": { "type": "string", "description": "SERVER-ONLY. Must equal the computed value from slots." },
          "par": { "type": ["integer", "null"], "description": "Median questions by the AI play-test agent." }
        }
      }
    }
  }
}
