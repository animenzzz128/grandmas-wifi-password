{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grandma.schema.json",
  "title": "GrandmaWorld",
  "description": "One Grandma's world: the haystack (facts) and the password recipes (needles). The server keeps recipes[].password secret; the client never receives facts or passwords.",
  "type": "object",
  "required": [
    "id",
    "version",
    "profile",
    "entities",
    "facts"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "description": "RNG seed for generated worlds; null for hand-written."
    },
    "source": {
      "enum": [
        "hand-written",
        "generated"
      ]
    },
    "profile": {
      "type": "object",
      "required": [
        "name",
        "birth_year",
        "hometown",
        "personality",
        "verbal_tics"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "birth_year": {
          "type": "integer",
          "minimum": 1925,
          "maximum": 1960
        },
        "hometown": {
          "type": "string"
        },
        "personality": {
          "type": "object",
          "required": [
            "talkativeness",
            "teasing",
            "nostalgia",
            "suspicion_of_kids_these_days"
          ],
          "additionalProperties": false,
          "properties": {
            "talkativeness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "teasing": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "nostalgia": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "suspicion_of_kids_these_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "humor_style": {
          "type": "string"
        },
        "verbal_tics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "person",
              "pet",
              "place",
              "object",
              "organization",
              "event"
            ]
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relation_to_player": {
            "type": "string",
            "description": "e.g. 'your mom', 'your great-uncle'"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "predicate",
          "object",
          "text",
          "salience"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "entity id"
          },
          "predicate": {
            "type": "string"
          },
          "object": {
            "type": [
              "string",
              "integer"
            ],
            "description": "entity id, literal string, or number"
          },
          "year": {
            "type": "integer"
          },
          "text": {
            "type": "string",
            "description": "Canonical natural-language statement, in Grandma's first person."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confusable_with": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "fact ids that a vague question could mix up with this one"
          },
          "misremembers": {
            "type": "integer",
            "description": "a wrong year (within 3 of year) she sometimes says first and then corrects: \"1962… no, '61\" (GDD §3.2)"
          },
          "disambiguator": {
            "type": "string",
            "description": "The qualifier that resolves the confusion, e.g. 'first', 'when your mom was born'"
          },
          "salience": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "How readily Grandma brings it up unprompted"
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phrase",
          "resolves_to_year",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "phrase": {
            "type": "string",
            "description": "How Grandma refers to the time, e.g. 'the winter Michael broke his arm sledding'"
          },
          "resolves_to_year": {
            "type": "integer"
          },
          "via_fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Facts the player can use to resolve the anchor"
          },
          "source": {
            "enum": [
              "family",
              "public"
            ]
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "fact_ids",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "colour": {
      "description": "Little things: everyday colour, not clues. No digits, answer words, time phrases or new names (checked by npm run validate).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "about",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "about": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "description": "Topic cards. Without them, cards are made from the entities.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "facts"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "person",
              "pet",
              "place",
              "event",
              "thing"
            ]
          },
          "match": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Whole-word phrases that unlock the card when said."
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "start_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "difficulty",
          "note_text",
          "slots",
          "format",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard",
              "expert"
            ]
          },
          "note_text": {
            "type": "string"
          },
          "smudged_text": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "fact_id",
                "field"
              ],
              "additionalProperties": false,
              "properties": {
                "fact_id": {
                  "type": "string"
                },
                "field": {
                  "enum": [
                    "object",
                    "year"
                  ]
                },
                "transform": {
                  "enum": [
                    "none",
                    "capitalize",
                    "lowercase",
                    "uppercase",
                    "first_word"
                  ],
                  "description": "first_word: keep only the first word of the entity name, e.g. Cherry Street -> Cherry"
                },
                "requires_anchor": {
                  "type": "string",
                  "description": "anchor id if the value is only given relatively"
                },
                "hidden": {
                  "type": "boolean",
                  "description": "Grandma doesn't remember this answer on the note: only the room shows it. Her memories that say it are left out of her mind, and the validator rejects a reply that says it."
                }
              }
            }
          },
          "literal_suffix": {
            "type": "string"
          },
          "format": {
            "type": "object",
            "required": [
              "join"
            ],
            "additionalProperties": false,
            "properties": {
              "join": {
                "type": "string"
              },
              "rules_shown_on_note": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "password": {
            "type": "string",
            "description": "SERVER-ONLY. Must equal the computed value from slots."
          },
          "par": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Median questions by the AI play-test agent."
          },
          "separate": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            },
            "description": "Groups of chain facts a single reply may use at most one of."
          },
          "nudges": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "In-character lines for a stuck player, pointing at the first hop."
          },
          "note_facts": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Per part of the note (split at +): the memories its topic card tells."
          }
        }
      },
      "description": "Fixed notes, if any. A world with parts and tiers gets its notes from the generator (packages/engine/src/compose.ts, docs/15)."
    },
    "parts": {
      "type": "array",
      "description": "The part bank (docs/15): one line of the note each, with everything the puzzle needs for it. The generator pairs a word part with a number part for each tier whose rules the pair meets.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "line",
          "slot",
          "hops",
          "nudges"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "kind": {
            "enum": [
              "word",
              "number"
            ]
          },
          "line": {
            "type": "string",
            "description": "The note's line for this part (no '+')."
          },
          "smudged": {
            "type": "string",
            "description": "The line with a smudge only the reading glasses read (tiers with smudge)."
          },
          "slot": {
            "type": "object",
            "required": [
              "fact_id",
              "field"
            ],
            "additionalProperties": false,
            "properties": {
              "fact_id": {
                "type": "string"
              },
              "field": {
                "enum": [
                  "object",
                  "year"
                ]
              },
              "transform": {
                "enum": [
                  "none",
                  "capitalize",
                  "lowercase",
                  "uppercase",
                  "first_word"
                ],
                "description": "first_word: keep only the first word of the entity name, e.g. Cherry Street -> Cherry"
              },
              "requires_anchor": {
                "type": "string",
                "description": "anchor id if the value is only given relatively"
              },
              "hidden": {
                "type": "boolean",
                "description": "Grandma doesn't remember this answer on the note: only the room shows it. Her memories that say it are left out of her mind, and the validator rejects a reply that says it."
              }
            }
          },
          "hops": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "Inference steps from the line to the answer; 0 when one direct question gives it (the probe test checks this)."
          },
          "needs_room": {
            "type": "boolean",
            "description": "A step only an object in the room gives (one more point)."
          },
          "decoys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Facts with a look-alike answer to rule out."
          },
          "note_facts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What her card for this line tells. Default: the slot's fact."
          },
          "separate": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            }
          },
          "nudges": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra rules printed on the note."
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "easy",
        "medium",
        "hard"
      ],
      "properties": {
        "easy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Total points of the two parts, inclusive (a part's points: hops, plus one if it needs the room)."
            },
            "max_part": {
              "type": "integer"
            },
            "min_top_part": {
              "type": "integer"
            },
            "room": {
              "enum": [
                "none",
                "required",
                "any"
              ]
            },
            "smudge": {
              "type": "boolean"
            },
            "suffixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "par": {
              "type": "integer"
            }
          }
        },
        "medium": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Total points of the two parts, inclusive (a part's points: hops, plus one if it needs the room)."
            },
            "max_part": {
              "type": "integer"
            },
            "min_top_part": {
              "type": "integer"
            },
            "room": {
              "enum": [
                "none",
                "required",
                "any"
              ]
            },
            "smudge": {
              "type": "boolean"
            },
            "suffixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "par": {
              "type": "integer"
            }
          }
        },
        "hard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Total points of the two parts, inclusive (a part's points: hops, plus one if it needs the room)."
            },
            "max_part": {
              "type": "integer"
            },
            "min_top_part": {
              "type": "integer"
            },
            "room": {
              "enum": [
                "none",
                "required",
                "any"
              ]
            },
            "smudge": {
              "type": "boolean"
            },
            "suffixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "par": {
              "type": "integer"
            }
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "description": "Retired note ids (saved visits, logs, tests) and the parts they are made of now.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tier",
          "parts"
        ],
        "properties": {
          "tier": {
            "enum": [
              "easy",
              "medium",
              "hard",
              "expert"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "suffix": {
            "type": "string"
          }
        }
      }
    }
  }
}
