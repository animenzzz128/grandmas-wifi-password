    {
      "id": "c_hum",
      "about": [
        "rosie"
      ],
      "text": "I hum while I bake. Your grandpa says it's always the same tune, and he's right."
    },
    {
      "id": "c_coupons",
      "about": [
        "rosie"
      ],
      "text": "I clip coupons every Sunday, even for things I'd never buy. It's the principle."
    },
    {
      "id": "c_pew",
      "about": [
        "rosie"
      ],
      "text": "I sit in the same pew every Sunday. If somebody takes it, I sit right next to them and sing louder."
    },
    {
      "id": "c_notes",
      "about": [
        "rosie"
      ],
      "text": "I still write my thank-you notes by hand. An email isn't a thank-you, it's a receipt."
    },
    {
      "id": "c_charging",
      "about": [
        "rosie"
      ],
      "text": "I don't trust anything that needs charging. The toaster doesn't need charging, and it works just fine."
    },
    {
      "id": "c_phone_voice",
      "about": [
        "rosie",
        "phone_co"
      ],
      "text": "All those days on the switchboard, and I still answer the telephone like I'm putting a call through."
    },
    {
      "id": "c_fast_calls",
      "about": [
        "rosie",
        "phone_co"
      ],
      "text": "I could connect a call faster than you kids can type a message, and with a smile in my voice too."
    },
    {
      "id": "c_sloppy_joes",
      "about": [
        "rosie",
        "lincoln_elem"
      ],
      "text": "Grown men still stop me at the grocery store to say they miss my sloppy joes from the school cafeteria."
    },
    {
      "id": "c_lunch_line",
      "about": [
        "rosie",
        "lincoln_elem"
      ],
      "text": "In the cafeteria I always knew which children skipped breakfast. They got the bigger scoop."
    },
    {
      "id": "c_walt_tv",
      "about": [
        "walt"
      ],
      "text": "Your grandpa argues with the news on the television, as if the anchorman can hear him."
    },
    {
      "id": "c_walt_snore",
      "about": [
        "walt"
      ],
      "text": "Your grandpa snores like a lawn mower, and he swears he's never snored a day in his life."
    },
    {
      "id": "c_walt_lures",
      "about": [
        "walt"
      ],
      "text": "Your grandpa has a tackle box full of lures he's never used, and he still comes home with a new one."
    },
    {
      "id": "c_walt_jokes",
      "about": [
        "walt"
      ],
      "text": "Your grandpa tells the same three jokes at every family dinner, and I laugh every time, because somebody has to."
    },
    {
      "id": "c_walt_coffee",
      "about": [
        "walt"
      ],
      "text": "Your grandpa makes coffee so strong the spoon could stand up in it."
    },
    {
      "id": "c_walt_car",
      "about": [
        "walt",
        "bel_air"
      ],
      "text": "Your grandpa used to polish that green car at red lights. People honked, and he waved like a movie star."
    },
    {
      "id": "c_walt_dance",
      "about": [
        "walt"
      ],
      "text": "Your grandpa can't dance, but he'll ask me anyway. I love him for asking."
    },
    {
      "id": "c_walt_cookies",
      "about": [
        "walt"
      ],
      "text": "Your grandpa can't find a thing in my kitchen, and that's the only reason my cookies last the week."
    },
    {
      "id": "c_stan_laugh",
      "about": [
        "stan"
      ],
      "text": "Uncle Stan laughs so loud the neighbours' dog starts barking."
    },
    {
      "id": "c_stan_cards",
      "about": [
        "stan"
      ],
      "text": "Uncle Stan can't play cards with a straight face. You can always tell if he's got a good hand."
    },
    {
      "id": "c_stan_fish",
      "about": [
        "stan",
        "walt"
      ],
      "text": "Uncle Stan and your grandpa argue about fishing like it's politics. Neither one ever catches anything."
    },
    {
      "id": "c_dot_hats",
      "about": [
        "dot"
      ],
      "text": "My sister Dot wears a hat to everything, even the grocery store."
    },
    {
      "id": "c_dot_calls",
      "about": [
        "dot"
      ],
      "text": "Dot calls me every Sunday night, and we talk until one of us dozes off."
    },
    {
      "id": "c_dot_tease",
      "about": [
        "dot"
      ],
      "text": "Dot still teases me about tripping at her wedding. I tell her I was only trying to steal the show."
    },
    {
      "id": "c_linda_bossy",
      "about": [
        "linda"
      ],
      "text": "Your mom was the bossiest little girl on the block. She lined up her dolls and gave them homework."
    },
    {
      "id": "c_linda_pills",
      "about": [
        "linda"
      ],
      "text": "Your mom calls every evening to make sure I've taken my pills. I tell her the pills should be checking on me."
    },
    {
      "id": "c_michael_toaster",
      "about": [
        "michael"
      ],
      "text": "Your uncle Michael takes apart anything with a screw in it. He fixed my toaster once, and it's never toasted the same."
    },
    {
      "id": "c_michael_loud",
      "about": [
        "michael"
      ],
      "text": "Your uncle Michael explains the computer to me very slowly and very loudly, as if the trouble were my ears."
    },
    {
      "id": "c_michael_pierogi",
      "about": [
        "michael"
      ],
      "text": "Your uncle Michael could eat a whole pan of pierogi as a boy, and then ask what was for dessert."
    },
    {
      "id": "c_friend_rummy",
      "about": [
        "marge",
        "bowling"
      ],
      "text": "My best friend and I have the same argument about the rules of gin rummy every single week."
    },
    {
      "id": "c_friend_talks",
      "about": [
        "marge",
        "bowling"
      ],
      "text": "My best friend talks through every frame at the bowling alley, and she still beats me half the time."
    },
    {
      "id": "c_pickles_paper",
      "about": [
        "pickles"
      ],
      "text": "Pickles used to sit on the newspaper the minute anybody opened it."
    },
    {
      "id": "c_pickles_walt",
      "about": [
        "pickles",
        "walt"
      ],
      "text": "Pickles hated everybody except your grandpa, and your grandpa pretended not to like him back."
    },
    {
      "id": "c_beagle_bells",
      "about": [
        "biscuit"
      ],
      "text": "That beagle of mine howled whenever the church bells rang, like he was joining the choir."
    },
    {
      "id": "c_spaniel_ears",
      "about": [
        "buttons"
      ],
      "text": "The cocker spaniel's ears dragged in her water bowl, so the kitchen floor was always wet."
    },
    {
      "id": "c_pierogi_pinch",
      "about": [
        "rosie"
      ],
      "text": "I make pierogi by hand the way my mother did, and I pinch every edge twice so they don't burst."
    },
    {
      "id": "c_pie_secret",
      "about": [
        "rosie",
        "county_fair"
      ],
      "text": "The secret to a good cherry pie is a pinch of almond, and not telling anybody about the almond."
    },
    {
      "id": "c_candy_apples",
      "about": [
        "county_fair"
      ],
      "text": "The best thing at the county fair is still the candy apples, and I've tried everything they sell."
    },
    {
      "id": "c_kochanie",
      "about": [
        "rosie",
        "walt"
      ],
      "text": "I call your grandpa 'kochanie' if I'm happy with him. If I'm not, I use his whole name."
    },
    {
      "id": "c_empty_chair",
      "about": [
        "rosie"
      ],
      "text": "On Christmas Eve we leave an empty chair at the table for a stranger, the old Polish way."
    },
    {
      "id": "c_tomatoes_talk",
      "about": [
        "rosie"
      ],
      "text": "I talk to my tomatoes every morning. The squirrels listen better than your grandpa does."
    },
    {
      "id": "c_lake_smell",
      "about": [
        "erie"
      ],
      "text": "On a windy day you can smell the lake from our backyard."
    },
    {
      "id": "c_presque_sunset",
      "about": [
        "presque_isle"
      ],
      "text": "Presque Isle has the prettiest sunsets on the whole lake, and I'll argue with anybody who says otherwise."
    },
    {
      "id": "c_bowling_shoes",
      "about": [
        "bowling"
      ],
      "text": "I bring my own bowling shoes. I'm not putting my feet where a hundred strangers have been."
    }
  ],
