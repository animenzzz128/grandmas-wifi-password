# Copy to .env and fill in. Never commit .env.
# Only the key in THIS file is used (keys exported by other tools are ignored on purpose).
ANTHROPIC_API_KEY=
# Runtime Grandma model and offline models (see docs/02-technical-design.md §5.3)
GRANDMA_MODEL=claude-haiku-5-5
WORLDGEN_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
AGENT_MODEL=claude-sonnet-5-5
# Server (API_PORT, not PORT, so tools that inject PORT do not collide)
API_PORT=8787
RATE_LIMIT_ASKS_PER_MIN=30
# Daily model spend limit in USD (UTC day). Past it, Grandma switches to the offline version until midnight UTC.
# Kill switch: create the file var/KILL (or /data/KILL on Fly) to switch her off without a redeploy.
GRANDMA_DAILY_BUDGET_USD=5
