# Copy to .env and fill in. Never commit .env.
# Only the key in THIS file is used (keys exported by other tools are ignored on purpose).
# One key: an OpenRouter key (sk-or-..., reaches every provider) or an Anthropic key. Either name works for either.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# Runtime Grandma model and offline models (why these: docs/13-model-choice.md).
# Claude ids like claude-haiku-5-5 also work with an OpenRouter key (they map to anthropic/claude-haiku-5.5).
GRANDMA_MODEL=anthropic/claude-haiku-5.5
# The judge is from another family than Grandma's model, so it doesn't grade its own family's style kindly.
JUDGE_MODEL=openai/gpt-6.1-terra
AGENT_MODEL=openai/gpt-6.1-terra
WORLDGEN_MODEL=anthropic/claude-opus-5.5
# Server (API_PORT, not PORT, so tools that inject PORT do not collide)
API_PORT=8787
RATE_LIMIT_ASKS_PER_MIN=30
# Daily model spend limit in USD (UTC day). Past it, Grandma switches to the offline version until midnight UTC.
# Kill switch: create the file var/KILL (or /data/KILL on Fly) to switch her off without a redeploy.
GRANDMA_DAILY_BUDGET_USD=5
# Sites allowed to show the game in a frame (an itch.io embed), space-separated. Empty: nobody may frame it.
# EMBED_ORIGINS=https://itch.io https://*.itch.zone
# Grandma's spoken voice (optional; iteration 53). Without these she uses the player's browser voice.
# Key: https://elevenlabs.io (Profile > API keys). Then design her voice: node tools/design-grandma-voice.mjs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5: fast and half the credits; eleven_multilingual_v2: richer, slower.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Characters she may speak per UTC day (repeated lines are cached and free). Past it: the browser voice.
VOICE_DAILY_CHARS=3000
